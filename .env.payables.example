# AP setup template. API starts without credentials and reports unavailable setup.
# Copy to .env only if it does not already exist; never overwrite credentials.
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
DATABASE_URL=
# Separate disposable PostgreSQL database; never the application database.
AP_TEST_DATABASE_URL=
BUSINESS_ID=local-business
DEMO_ACCESS_CODE=
REVIEWER_ACCESS_CODE=
SESSION_SECRET=
EXTRACTION_MODEL_BASE_URL=https://generativelanguage.googleapis.com/v1beta
EXTRACTION_MODEL_API_KEY=
EXTRACTION_MODEL_ID=
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
CIRCLE_WALLET_ID=
CIRCLE_BLOCKCHAIN=ARC-TESTNET
ARC_RPC_URL=https://rpc.testnet.arc.io
ARC_WALLET_ADDRESS=
ARC_CHAIN_ID=5042002
ARC_USDC_ADDRESS=0x3600000000000000000000000000000000000000
PAYMENT_MODE=disabled
SCREENING_MODE=local_registry
# Required explicit RPC-estimate buffers for read-only treasury planning.
# Circle submission/fee-ceiling validation is still separate; dispatch stays disabled.
FEE_BUFFER_BPS=2500
FEE_EXTRA_BUFFER_MICRO_USDC=1000
WORKER_POLL_MS=30000
# Poll range: 1000–60000 ms. Upload limits may be reduced below these hard caps.
MAX_INPUT_BYTES=5000000
MAX_INPUT_PIXELS=20000000
INPUT_RETENTION_HOURS=168
# Proposed values only; seed:payables reads policy from its JSON manifest, not these variables.
# After enrollment the versioned database policy is authoritative.
AUTO_PAY_MAX_MICRO_USDC=2000000
HARD_TX_MAX_MICRO_USDC=5000000
DAILY_BUDGET_MICRO_USDC=10000000
MIN_RESERVE_MICRO_USDC=5000000

# Explicit opt-in after configuring and verifying the intended Arc Testnet wallet.
PAYMENT_DISPATCH_ENABLED=false
